# ICEPOPS Backend Environment Template

# Database
# For Neon / Supabase / Cloud Postgres:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<database>?sslmode=require
# For Local Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/icepops

# Admin Credentials
ADMIN_EMAIL=manojkumarbondada13@gmail.com
ADMIN_PASSWORD=Admin@12345

# Public App URLs & Allowed CORS Origins (comma-separated)
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Razorpay Online Payment Gateway
# Test Mode Key ID:
RAZORPAY_KEY_ID=rzp_test_Txd5kzeL6T6dBG
# Razorpay Key Secret from Razorpay Dashboard -> Settings -> API Keys:
RAZORPAY_KEY_SECRET=
# Razorpay Webhook Secret from Razorpay Dashboard -> Webhooks:
RAZORPAY_WEBHOOK_SECRET=

# Email Settings
EMAIL_FROM_NAME=ICEPOPS
EMAIL_REPLY_TO=manojkumarbondada13@gmail.com
# Optional: Resend / Emergent Email Key (if left blank, emails are logged to console)
EMERGENT_EMAIL_KEY=
